# Copy this file to .env.local.
# Local default is DEMO mode; to use real accounts and workspace data set production mode.
VITE_LOCALPULSE_MODE=demo

# Supabase project values (Project Settings -> API).
# Use the project URL and publishable/anon key only; never paste service_role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
